generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuestionType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
}

enum QuestionDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
}

enum DocumentStatus {
  UPLOADED
  EXTRACTING
  ANALYZING
  REVIEW_PENDING
  SAVED
  FAILED
  DISCARDED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  attempts     Attempt[]
  topics       Topic[]
  documents    Document[]
}

model Topic {
  id            String         @id @default(cuid())
  userId        String
  name          String
  slug          String
  description   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningCards LearningCard[]
  questions     Question[]
  attempts      Attempt[]
  documents     Document[]

  @@unique([userId, slug])
  @@index([userId])
}

model Document {
  id                 String         @id @default(cuid())
  userId             String
  topicId            String?
  filename           String
  storagePath        String
  mimeType           String
  sizeBytes          Int
  pageCount          Int?
  extractedChars     Int?
  status             DocumentStatus
  errorCode          String?
  errorMessage       String?
  summary            String?
  keyPoints          Json?
  draftCards         Json?
  suggestedTopicName String?
  analysisProgress   Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic              Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)
  learningCards      LearningCard[]

  @@index([userId])
  @@index([topicId])
  @@index([status])
}

model LearningCard {
  id            String    @id @default(cuid())
  topicId       String
  documentId    String?
  title         String
  content       String
  codeExample   String?
  developerNote String?
  sourceRef     String?
  order         Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  topic         Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  document      Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  questions     Question[]

  @@unique([topicId, order])
  @@index([documentId])
}

model Question {
  id                String             @id @default(cuid())
  topicId           String
  type              QuestionType
  prompt            String
  difficulty        QuestionDifficulty
  explanation       String
  order             Int
  sourceFingerprint String?
  generationId      String?
  sourceCardId      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  topic             Topic              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  sourceCard        LearningCard?      @relation(fields: [sourceCardId], references: [id], onDelete: SetNull)
  options           QuestionOption[]
  tags              Tag[]
  attemptAnswers    AttemptAnswer[]

  @@unique([topicId, order])
  @@index([topicId, sourceFingerprint, generationId])
  @@index([sourceCardId])
}

model QuestionOption {
  id              String          @id @default(cuid())
  questionId      String
  text            String
  isCorrect       Boolean
  order           Int
  question        Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedAnswers AttemptAnswer[]

  @@unique([questionId, order])
}

model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  questions Question[]
}

model Attempt {
  id             String         @id @default(cuid())
  userId         String
  topicId        String
  submissionId   String
  status         AttemptStatus
  correctCount   Int
  totalQuestions Int
  percentage     Int
  startedAt      DateTime       @default(now())
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic          Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  answers        AttemptAnswer[]

  @@unique([userId, submissionId])
  @@index([userId])
  @@index([topicId])
}

model AttemptAnswer {
  id               String         @id @default(cuid())
  attemptId        String
  questionId       String
  selectedOptionId String
  isCorrect        Boolean
  createdAt        DateTime       @default(now())
  attempt          Attempt        @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         Question       @relation(fields: [questionId], references: [id])
  selectedOption   QuestionOption @relation(fields: [selectedOptionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@index([selectedOptionId])
}

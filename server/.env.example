PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Optional. Absolute path to the Vite production build (client/dist).
# CLIENT_DIST=
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/devpath?schema=public"

# Required. Use a long random string in every environment.
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# JWT and auth cookie lifetime in seconds. Default: 7 days.
AUTH_TOKEN_TTL_SECONDS=604800

# Cookie flags. Local HTTP development uses secure=false and SameSite=Lax.
# Production should typically set AUTH_COOKIE_SECURE=true.
# If AUTH_COOKIE_SAMESITE=none, the cookie is always marked Secure.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Upload, analysis, and practice-generation rate limits. Defaults to on in production.
# RATE_LIMIT_ENABLED=true

# Local PDF uploads. Relative paths are resolved from the process working directory.
UPLOAD_DIR=uploads

# Optional. Shared site password. Empty = no lock screen (local default).
# Production enables the lock automatically when this is set.
# Local preview: also set SITE_GATE_ENABLED=true.
# SITE_ACCESS_PASSWORD=
# SITE_GATE_ENABLED=true

# OpenAI chat completions for document analysis and practice questions.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

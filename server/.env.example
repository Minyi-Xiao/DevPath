PORT=3000
CLIENT_URL=http://localhost:5173
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/devpath?schema=public"

# Required. Use a long random string in every environment.
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# JWT and auth cookie lifetime in seconds. Default: 7 days.
AUTH_TOKEN_TTL_SECONDS=604800

# Cookie flags. Local HTTP development uses secure=false and SameSite=Lax.
# Production should typically set AUTH_COOKIE_SECURE=true.
# If AUTH_COOKIE_SAMESITE=none, the cookie is always marked Secure.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Public site origin. deploy.ps1 fills this with the CloudFront HTTPS URL.
# Override with https://your.domain if you later attach a real domain.
CLIENT_URL=https://REPLACE_WITH_CLOUDFRONT_DOMAIN
# Caddy origin stays HTTP; CloudFront terminates TLS.
SITE_ADDRESS=:80
AUTH_COOKIE_SECURE=true

# Required secrets
JWT_SECRET=
POSTGRES_PASSWORD=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Shared site lock. Required in production if you do not want the AI endpoints public.
SITE_ACCESS_PASSWORD=

# Filled by deploy.ps1
ECR_IMAGE=
AWS_REGION=

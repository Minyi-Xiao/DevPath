# Public site origin. Use http://ELASTIC_IP until you attach a domain.
CLIENT_URL=http://REPLACE_WITH_ELASTIC_IP
SITE_ADDRESS=:80
AUTH_COOKIE_SECURE=false

# Required secrets
JWT_SECRET=
POSTGRES_PASSWORD=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Shared site lock. Required in production if you do not want the AI endpoints public.
SITE_ACCESS_PASSWORD=

# Filled by deploy.ps1
ECR_IMAGE=
AWS_REGION=
